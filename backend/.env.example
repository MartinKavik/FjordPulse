# Backend normally reads the repository-root .env. This file documents the
# minimum variables needed when running backend commands directly.
APP_ENV=development
APP_DEBUG=true
DATA_MODE=real
SCENARIO=normal
MAPTILER_API_KEY=
APP_ORIGIN=http://127.0.0.1:8080
ALLOWED_ORIGINS=http://127.0.0.1:8080,http://127.0.0.1:5173
SURREAL_URL=ws://127.0.0.1:8000/rpc
SURREAL_NAMESPACE=fjordpulse
SURREAL_DATABASE=fjordpulse_real
SURREAL_USERNAME=fjordpulse_app
SURREAL_PASSWORD=local-development-only
ENTUR_CLIENT_NAME=martinkavik-fjordpulse
ENTUR_GLOBAL_REQUESTS_PER_MINUTE=120
ENTUR_STOP_PLACE_REQUESTS_PER_MINUTE=60
STATION_IMPORT_PAGE_SIZE=1000
STATION_IMPORT_WRITE_CHUNK_SIZE=1000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=local-development-only
ADMIN_SESSION_SECRET=replace-in-production
