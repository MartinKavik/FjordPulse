{
  "name": "fjordpulse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.22.0"
  },
  "scripts": {
    "contracts": "redocly lint contracts/http/openapi.yaml && node scripts/validate-contracts.mjs",
    "infra": "node scripts/validate-infra.mjs",
    "e2e": "npm run e2e:fixture && npm run e2e:live",
    "e2e:fixture": "playwright test --project=chromium",
    "e2e:live": "playwright test --config=playwright.live.config.ts",
    "visual": "playwright test --project=visual"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.61.1",
    "@redocly/cli": "2.38.0",
    "@types/node": "26.1.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "yaml": "2.9.0"
  }
}
