#!/usr/bin/env bash
set -euo pipefail

readonly VERSION='1.12.4'
readonly SHA256='67796f0348db0c3a8ab5cea732292d6211d16d543b08944bd08b3510923a212c'
readonly CACHE_DIR="${XDG_CACHE_HOME:-${HOME}/.cache}/fjordpulse-tools/frankenphp/${VERSION}"
readonly BINARY="${CACHE_DIR}/frankenphp"

install_frankenphp() {
  mkdir -p "${CACHE_DIR}"
  local temporary="${BINARY}.download.$$"
  curl --fail --location --retry 3 \
    "https://github.com/php/frankenphp/releases/download/v${VERSION}/frankenphp-linux-x86_64-gnu" \
    --output "${temporary}"
  printf '%s  %s\n' "${SHA256}" "${temporary}" | sha256sum --check --status
  chmod +x "${temporary}"
  mv "${temporary}" "${BINARY}"
}

if [[ ! -x "${BINARY}" ]] || ! printf '%s  %s\n' "${SHA256}" "${BINARY}" | sha256sum --check --status; then
  install_frankenphp
fi

exec "${BINARY}" "$@"
