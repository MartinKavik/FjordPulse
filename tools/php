#!/usr/bin/env bash
set -euo pipefail

readonly VERSION='1.12.4'
readonly SHA256='4427339c15253f08e679df44adc27f62140d1be4c99c039b328247d0a63dccc9'
readonly CACHE_DIR="${XDG_CACHE_HOME:-${HOME}/.cache}/fjordpulse-tools/frankenphp/${VERSION}"
readonly BINARY="${CACHE_DIR}/frankenphp"

install_frankenphp() {
  mkdir -p "${CACHE_DIR}"
  local temporary="${BINARY}.download.$$"
  curl --fail --location --retry 3 \
    "https://github.com/php/frankenphp/releases/download/v${VERSION}/frankenphp-linux-x86_64-gnu" \
    --output "${temporary}"
  printf '%s  %s\n' "${SHA256}" "${temporary}" | sha256sum --check
  chmod +x "${temporary}"
  mv "${temporary}" "${BINARY}"
}

if [[ ! -x "${BINARY}" ]] || ! printf '%s  %s\n' "${SHA256}" "${BINARY}" | sha256sum --check --status; then
  install_frankenphp
fi

if [[ ${1:-} == '-v' || ${1:-} == '--version' ]]; then
  exec "${BINARY}" version
fi

# Composer tools such as PHPStan start child workers through
# `/usr/bin/env php -d name=value script.php ...`. FrankenPHP's `php-cli`
# subcommand accepts a script and its arguments but not CLI-only `-d` flags;
# discard those worker hints before forwarding to the same pinned runtime.
while [[ ${1:-} == '-d' ]]; do
  shift
  [[ $# -gt 0 ]] && shift
done

if [[ $# -eq 0 ]]; then
  printf 'Usage: tools/php <script.php> [arguments...]\n' >&2
  exit 64
fi

exec "${BINARY}" php-cli "$@"
