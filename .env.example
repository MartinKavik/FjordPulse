# Runtime
APP_ENV=development
APP_DEBUG=true
APP_VERSION=dev
APP_ORIGIN=http://127.0.0.1:8080
ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080,http://127.0.0.1:5173,http://localhost:5173
HTTP_HOST=127.0.0.1
HTTP_PORT=8080
REALTIME_HOST=127.0.0.1
REALTIME_PORT=8081
REALTIME_PUBLIC_URL=ws://127.0.0.1:8081/live

# Normal local and production routes use real Entur data. `make dev-demo`
# overrides this with isolated fake data for deterministic demonstrations/tests.
DATA_MODE=real
SCENARIO=normal

# Public read-only MapTiler browser key managed by the FjordPulse operator.
# Protect production keys with allowed HTTP origins in MapTiler Cloud.
MAPTILER_API_KEY=

# SurrealDB local service. Replace every credential in production.
SURREAL_URL=ws://127.0.0.1:8000/rpc
SURREAL_HTTP_URL=http://127.0.0.1:8000
SURREAL_NAMESPACE=fjordpulse
SURREAL_DATABASE=fjordpulse_real
SURREAL_USERNAME=fjordpulse_app
SURREAL_PASSWORD=local-development-only
SURREAL_ROOT_USERNAME=root
SURREAL_ROOT_PASSWORD=root
SURREAL_DATA_PATH=.data/surreal-real

# Entur open APIs. This is an identity header, not a secret.
ENTUR_CLIENT_NAME=martinkavik-fjordpulse
ENTUR_GEOCODER_URL=https://api.entur.io/geocoder/v3
ENTUR_JOURNEY_PLANNER_URL=https://api.entur.io/journey-planner/v3/graphql
ENTUR_VEHICLE_POSITIONS_URL=https://api.entur.io/realtime/v2/vehicles/graphql
ENTUR_VEHICLE_SUBSCRIPTIONS_URL=wss://api.entur.io/realtime/v2/vehicles/subscriptions
ENTUR_STOP_PLACES_URL=https://api.entur.io/stop-places/v1/read
ENTUR_GLOBAL_REQUESTS_PER_MINUTE=120
ENTUR_STOP_PLACE_REQUESTS_PER_MINUTE=60
ENTUR_GEOCODER_REQUESTS_PER_MINUTE=20
ENTUR_JOURNEY_REQUESTS_PER_MINUTE=30
ENTUR_VEHICLE_REQUESTS_PER_MINUTE=30

# Collection and retention
STATION_FRESH_SECONDS=30
VEHICLE_FRESH_SECONDS=10
VEHICLE_STALE_SECONDS=30
VEHICLE_LOST_SECONDS=300
WATCH_TTL_SECONDS=60
FALLBACK_POLL_SECONDS=15
VEHICLE_OBSERVATION_RETENTION_HOURS=24
REALTIME_EVENT_RETENTION_HOURS=24
STATION_IMPORT_PAGE_SIZE=1000
STATION_IMPORT_WRITE_CHUNK_SIZE=1000

# Admin: set a strong password or hash outside development.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=local-development-only
ADMIN_SESSION_SECRET=replace-in-production
# Separate public, read-only demo identity. Never reuse operator/session/database secrets.
# Secure config defaults it off;
# `make dev` / `make dev-demo` explicitly enable it for local manual testing.
ADMIN_DEMO_ACCESS=false
ADMIN_DEMO_USERNAME=demo
ADMIN_DEMO_PASSWORD=fjordpulse-demo

# Structured logging
LOG_LEVEL=info
LOG_FORMAT=json
