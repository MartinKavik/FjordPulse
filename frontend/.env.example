# Application API and WebSocket traffic remain on the FjordPulse origin.
# Normal maps additionally use the fixed MapTiler HTTPS host returned by /api/map/config.
VITE_API_BASE=/api
VITE_REALTIME_PATH=/live

# api = real CakePHP HTTP/WebSocket services; fixture is local visual development only.
VITE_DATA_MODE=api
# Explicit opt-in for built visual-test previews. Never enable on production hosting.
VITE_ENABLE_FIXTURES=false
VITE_FALLBACK_POLL_MS=15000

# Basemap configuration and the operator-managed browser key are delivered at
# runtime by GET /api/map/config; end users never configure map credentials.
