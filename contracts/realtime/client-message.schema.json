{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fjordpulse.kavik.cz/contracts/realtime/client-message.schema.json",
  "title": "FjordPulse client realtime message",
  "type": "object",
  "required": ["id", "type", "payload"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "type": {
      "type": "string",
      "enum": [
        "watch_station", "unwatch_station", "watch_vehicle", "unwatch_vehicle",
        "focus_vehicle", "unfocus_vehicle", "pause_focus", "resume_focus", "ping"
      ]
    },
    "payload": {
      "type": "object",
      "properties": {
        "stationId": { "type": "string" },
        "vehicleId": { "type": "string" },
        "lastEventId": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "enum": ["watch_station", "unwatch_station"] } } },
      "then": { "properties": { "payload": { "required": ["stationId"] } } }
    },
    {
      "if": { "properties": { "type": { "enum": ["watch_vehicle", "unwatch_vehicle", "focus_vehicle", "unfocus_vehicle", "pause_focus", "resume_focus"] } } },
      "then": { "properties": { "payload": { "required": ["vehicleId"] } } }
    }
  ],
  "additionalProperties": false
}
